{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/js/(.*)", "dest": "/assets/js/$1" },
    { "src": "/css/(.*)", "dest": "/assets/css/$1" },
    { "src": "/images/(.*)", "dest": "/assets/images/$1" },
    { "src": "/(.*)", "dest": "/pages/$1.html" },
    { "handle": "filesystem" }
  ]
}